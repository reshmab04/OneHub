# OneHub Environment Variables
# Copy this file to backend/.env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# GitHub API (optional - increases rate limit from 60 to 5000 requests/hour)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Supabase Storage (for cloud file synchronization)
# Get these from your Supabase project: Settings → API Keys
# Create a storage bucket named "onehub-files" in Storage → New Bucket
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-secret-key-here
SUPABASE_BUCKET=onehub-files

# Authentication - Admin account (seeded on first run when no admin exists in the DB)
ADMIN_EMAIL=admin@onehub.app
ADMIN_PASSWORD=Admin@2024!

# JWT secret — use a strong random string ≥32 characters in production
# In development, a random secret is generated automatically if this is empty
JWT_SECRET=
